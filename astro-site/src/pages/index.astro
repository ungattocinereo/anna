  .mobile-menu.open .mobile-link:nth-child(5) { transition-delay: 0.28s; }
  .mobile-link:hover { color: var(--coral); }
  .mobile-link--cta { color: var(--coral); }

  @media (prefers-reduced-motion: reduce) {
