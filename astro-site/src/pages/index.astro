  }
  .btn-primary:hover { box-shadow: 0 10px 28px rgba(232,114,92,0.45); }
  .btn-outline {
    background: transparent; color: #fff;
    border: 2px solid rgba(255,255,255,0.5);
  }
  .btn-outline:hover { background: rgba(255,255,255,0.1); border-color: #fff; }
  .btn-sm { padding: 12px 24px; font-size: 0.75rem; letter-spacing: 1.5px; min-height: 44px; }

  /* ============= SECTION LABELS ============= */
  .section-label {
    display: block;
    font-family: 'Montserrat', sans-serif;
    font-weight: 800; font-size: 0.7rem;
    text-transform: uppercase; letter-spacing: 4px;
    color: var(--coral); margin-bottom: 8px;
  }
  .section-label--center { text-align: center; }
  .section-title {
    font-family: 'Montserrat', sans-serif;
    font-weight: 900; font-size: clamp(1.8rem, 4vw, 2.6rem);
    text-transform: uppercase; letter-spacing: 3px;
    color: var(--navy); text-align: center; margin-bottom: 16px;
  }
  .coral-rule {
    width: 60px; height: 3px; background: var(--coral);
    margin: 0 auto 48px;
  }

  /* ============= NAV ============= */
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
    padding: 0 48px; height: 72px;
    display: flex; align-items: center; justify-content: space-between;
    background: rgba(26,54,93,0.0);
    backdrop-filter: blur(0px);
    transition: background 0.5s, backdrop-filter 0.5s, box-shadow 0.5s;
  }
  .nav.scrolled {
    background: rgba(245,240,232,0.95);
    backdrop-filter: blur(20px);
    box-shadow: 0 1px 20px rgba(26,54,93,0.08);
  }
  .nav-logo {
    font-family: 'Montserrat', sans-serif; font-weight: 600;
    font-size: 1.4rem; letter-spacing: 0; color: #fff;
    transition: color 0.5s;
  }
  .nav.scrolled .nav-logo { color: var(--navy); }
  .nav-links { display: flex; gap: 4px; align-items: center; }
  .nav-links a {
    font-family: 'Montserrat', sans-serif;
    font-weight: 700; font-size: 0.75rem;
    color: rgba(255,255,255,0.8); text-transform: uppercase; letter-spacing: 1.5px;
    padding: 8px 14px; position: relative;
    transition: color var(--transition);
  }
  .nav.scrolled .nav-links a { color: var(--navy); }
  .nav-links a::after {
    content: ''; position: absolute; bottom: 4px; left: 14px; right: 14px;
    height: 2px; background: var(--coral);
    transform: scaleX(0); transform-origin: center;
    transition: transform var(--transition);
  }
  .nav-links a:hover::after { transform: scaleX(1); }
  .nav-cta {
    background: var(--coral) !important; color: #fff !important;
    padding: 10px 24px !important; border-radius: var(--radius) !important;
    font-weight: 800 !important;
  }
  .nav-cta::after { display: none !important; }
  .nav-cta:hover { box-shadow: 0 4px 16px rgba(232,114,92,0.3); }

  .burger { display: none; flex-direction: column; gap: 5px; z-index: 1100; padding: 8px; }
  .burger span { display: block; width: 26px; height: 2.5px; background: #fff; border-radius: 1px; transition: var(--transition); }
  .nav.scrolled .burger span { background: var(--navy); }
  .burger.active span { background: #fff !important; }
  .burger.active span:nth-child(1) { transform: rotate(45deg) translate(5px,5.5px); }
  .burger.active span:nth-child(2) { opacity: 0; }
  .burger.active span:nth-child(3) { transform: rotate(-45deg) translate(5px,-5.5px); }

  .mobile-menu {
    position: fixed; inset: 0; z-index: 1050;
    background: linear-gradient(135deg, var(--navy), var(--navy-dark));
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24px;
    opacity: 0; pointer-events: none; transition: opacity 0.4s;
  }
  .mobile-menu.open { opacity: 1; pointer-events: all; }
  .mobile-link {
    font-family: 'Montserrat', sans-serif; font-size: 1.3rem; font-weight: 800;
    color: #fff; text-transform: uppercase; letter-spacing: 4px;
  }
  .mobile-link:hover { color: var(--coral); }
  .mobile-link--cta { color: var(--coral); }

  @media (max-width: 900px) {
    .nav { padding: 0 20px; }
    .nav-links { display: none; }
    .burger { display: flex; }
  }

  /* ============= HERO ============= */
  .hero {
    position: relative; min-height: 100vh;
    display: flex; align-items: flex-end;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0;
  }
  .hero-bg img {
    width: 100%; height: 100%; object-fit: cover;
    animation: heroZoom 25s ease-in-out infinite alternate;
  }
  @keyframes heroZoom {
    0% { transform: scale(1); }
    100% { transform: scale(1.08); }
  }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(0deg, rgba(15,34,64,0.85) 0%, rgba(15,34,64,0.3) 50%, rgba(15,34,64,0.1) 100%);
  }
  .hero-content {
    position: relative; z-index: 2;
    padding: 0 48px 100px; max-width: 800px;
  }
  .hero-label {
    display: inline-block;
    font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 0.7rem;
    text-transform: uppercase; letter-spacing: 0; color: var(--navy);
    background: rgba(255,255,255,0.65); backdrop-filter: blur(8px);
    padding: 6px 16px; border-radius: 50px;
    margin-bottom: 20px;
  }
  .hero-content h1 {
    font-family: 'Montserrat', sans-serif; font-weight: 900;
    font-size: clamp(3rem, 7vw, 5.5rem);
    color: #fff; line-height: 1.05; letter-spacing: 4px;
    margin-bottom: 20px;
  }
  .hero-sub {
    font-family: 'DM Sans', sans-serif; font-weight: 600;
    font-size: 1.2rem; color: rgba(255,255,255,0.85);
    margin-bottom: 40px; max-width: 440px;
  }
  .hero-buttons { display: flex; gap: 16px; flex-wrap: wrap; }

  .hero-scroll {
    position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%);
    z-index: 2;
  }
  .hero-scroll span {
    display: block; width: 2px; height: 40px;
    background: rgba(255,255,255,0.4);
    animation: scrollPulse 2s ease infinite;
  }
  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(0.6); }
    50% { opacity: 1; transform: scaleY(1); }
  }

  @media (max-width: 768px) {
    .hero-content { padding: 0 24px 80px; }
    .hero-content h1 { font-size: 2.6rem; letter-spacing: 2px; }
    .hero-bg img, .hero-bg picture img { animation: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-bg img, .hero-bg picture img { animation: none; }
  }

  /* ============= ABOUT ============= */
  .about {
    position: relative; background: var(--sand); padding: 100px 0 40px; overflow: hidden;
  }
  .diagonal-pattern {
    position: absolute; top: 0; right: 0; bottom: 0; width: 40%;
    background: repeating-linear-gradient(
      -45deg, transparent, transparent 20px,
      rgba(26,54,93,0.03) 20px, rgba(26,54,93,0.03) 21px
    );
    pointer-events: none;
  }
  .about-inner {
    display: flex; gap: 60px; align-items: center;
    max-width: 1100px; margin: 0 auto; padding: 0 24px;
    position: relative; z-index: 1;
  }
  .about-photo {
    flex: 0 0 35%; max-width: 380px;
  }
  .about-photo img {
    width: 100%; aspect-ratio: 3/4; object-fit: cover;
    border-radius: 2px;
    box-shadow: 0 20px 60px rgba(26,54,93,0.15);
  }
  .about-text { flex: 1; }
  .about-text h2 {
    font-family: 'Montserrat', sans-serif; font-weight: 900;
    font-size: 2rem; text-transform: uppercase; letter-spacing: 2px;
    color: var(--navy); margin-bottom: 8px;
  }
  .about-text h2 em {
    font-family: 'Playfair Display', serif; font-style: italic;
    text-transform: none; letter-spacing: 0; font-weight: 700;
  }
  .about-line { width: 40px; height: 3px; background: var(--coral); margin-bottom: 24px; }
  .about-text p {
    font-size: 1rem; color: #555; line-height: 1.85; margin-bottom: 12px;
  }
  .about-text strong { color: var(--coral); }
  .about-text em { color: var(--navy); font-weight: 600; }
  .about-quote {
    font-family: 'Playfair Display', serif; font-style: italic;
    font-size: 1.05rem; color: #555; text-align: center;
    background: rgba(244,208,63,0.12); padding: 24px 32px;
    border-radius: 12px; margin: 24px 0; line-height: 1.6;
  }
  .quote-mark { color: var(--gold); font-weight: 700; }

  @media (max-width: 768px) {
    .about-inner { flex-direction: column; gap: 40px; }
    .about-photo { flex: none; width: 260px; margin: 0 auto; }
    .about-text { text-align: center; }
    .about-line { margin-left: auto; margin-right: auto; }
    .diagonal-pattern { display: none; }
  }

  /* ============= TOURS ============= */
  .tours { background: var(--sand); padding: 20px 0 100px; }

  .tour-block {
    background: var(--white); border-radius: var(--radius);
    overflow: visible; box-shadow: var(--shadow);
    margin-bottom: 32px; position: relative;
  }
  .tour-block--compact { }

  .tour-cover {
    position: relative; min-height: 340px; overflow: hidden; border-radius: var(--radius) var(--radius) 0 0;
  }
  .tour-cover--short { min-height: 340px; }
  .tour-cover img {
    width: 100%; height: 100%; object-fit: cover;
    position: absolute; inset: 0;
  }
  .tour-cover-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(0deg, rgba(15,34,64,0.85) 0%, rgba(15,34,64,0.2) 60%, transparent 100%);
  }
  .tour-cover-content {
    position: relative; z-index: 2;
    padding: 32px; display: flex; flex-direction: column;
    justify-content: flex-end; height: 100%; min-height: inherit;
  }
  .tour-tag {
    position: absolute; top: -16px; left: 32px; z-index: 2;
    font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 0.75rem;
    text-transform: uppercase; letter-spacing: 0; color: var(--navy);
    background: var(--white); border: 1.5px solid rgba(27,58,92,0.15);
    padding: 8px 20px; border-radius: 50px;
  }
  .tour-cover-content h3 {
    font-family: 'Montserrat', sans-serif; font-weight: 900;
    font-size: clamp(1.4rem, 3vw, 2rem); text-transform: uppercase; letter-spacing: 2px;
    color: #fff; margin-bottom: 8px;
  }
  .tour-route {
    font-size: 0.9rem; color: var(--coral); font-weight: 700; margin-bottom: 8px;
  }
  .tour-meta-line {
    font-size: 0.82rem; color: rgba(255,255,255,0.6); font-weight: 500;
  }
  .tour-block--compact .tour-meta-line { color: var(--text-light); }

  .tour-details { padding: 32px; }

  .tour-intro-text {
    font-size: 0.95rem; color: var(--text-light);
    font-style: italic; margin-bottom: 24px;
    padding-bottom: 20px; border-bottom: 1px solid var(--sand-dark);
  }

  .tour-desc-cols {
    display: grid; grid-template-columns: 1fr 1fr; gap: 24px;
    margin-bottom: 28px;
  }
  .tour-desc-cols--3 {
    grid-template-columns: 1fr 1fr 1fr;
  }
  .tour-desc-item h4 {
    font-family: 'Montserrat', sans-serif; font-weight: 800;
    font-size: 0.9rem; color: var(--navy); margin-bottom: 6px;
    text-transform: uppercase; letter-spacing: 1px;
  }
  .tour-desc-item p {
    font-size: 0.92rem; color: #555; line-height: 1.75;
  }

  .tour-desc-full p {
    font-size: 0.95rem; color: #555; line-height: 1.8; margin-bottom: 12px;
  }
  .tour-desc-full { margin-bottom: 24px; }

  .tour-list {
    padding-left: 20px; margin-bottom: 12px;
  }
  .tour-list li {
    font-size: 0.95rem; color: #555; line-height: 1.75; list-style: disc;
  }

  .tour-block-header { margin-bottom: 20px; }
  .tour-block-title {
    font-family: 'Montserrat', sans-serif; font-weight: 900;
    font-size: 1.15rem; text-transform: uppercase; letter-spacing: 1.5px;
    color: var(--navy); margin-bottom: 6px; margin-top: 4px;
  }

  .tour-sub-label {
    font-family: 'Montserrat', sans-serif; font-weight: 800;
    font-size: 0.8rem; text-transform: uppercase; letter-spacing: 2px;
    color: var(--navy); margin-bottom: 16px;
  }

  .boat-grid {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px; margin-bottom: 20px;
  }
  .boat-card {
    background: var(--sand); border-radius: var(--radius);
    overflow: hidden; position: relative;
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .boat-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .boat-card--featured { border: 2px solid var(--coral); }
  .boat-badge {
    position: absolute; top: 10px; right: 10px; z-index: 2;
    background: var(--coral); color: #fff;
    font-family: 'Montserrat', sans-serif; font-weight: 800;
    padding: 4px 12px; border-radius: 2px;
    font-size: 0.6rem; text-transform: uppercase; letter-spacing: 1.5px;
  }
  .boat-card-img {
    height: 160px; overflow: hidden; background: var(--white);
    display: flex; align-items: center; justify-content: center;
  }
  .boat-card-img img { width: 100%; height: 100%; object-fit: cover; }
  .boat-card-body { padding: 16px; }
  .boat-card-body h4 {
    font-family: 'Montserrat', sans-serif; font-weight: 800;
    font-size: 0.95rem; color: var(--navy); margin-bottom: 4px;
  }
  .boat-spec { font-size: 0.78rem; color: var(--text-light); display: block; margin-bottom: 6px; }
  .boat-price {
    font-family: 'Montserrat', sans-serif; font-weight: 800;
    font-size: 1.15rem; color: var(--navy); margin-bottom: 6px;
  }
  .boat-note { font-size: 0.75rem; color: var(--coral); font-style: italic; margin-bottom: 8px; }
  .tour-cta-link {
    font-family: 'Montserrat', sans-serif; font-weight: 700; font-size: 0.78rem;
    color: var(--coral); text-transform: uppercase; letter-spacing: 1.5px;
    display: inline-flex; gap: 4px; transition: gap var(--transition);
  }
  .tour-cta-link:hover { gap: 8px; }

  .tour-duration-note {
    font-size: 0.88rem; color: #777; line-height: 1.6;
    margin-bottom: 12px; font-style: italic;
  }
  .tour-departure {
    font-size: 0.88rem; color: #666;
  }
  .tour-departure strong { color: var(--navy); }

  .tour-pricing {
    background: var(--sand); border-radius: var(--radius); padding: 24px;
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: 16px; margin-top: 24px;
  }
  .tour-pricing-main { }
  .tour-pricing--split {
    display: grid; grid-template-columns: 1fr 2fr; gap: 32px; align-items: start;
  }
  .tour-pricing-left { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .tour-pricing-right { text-align: left; }
  .tour-pricing-right .tour-pickup { margin: 0; }
  .tour-price {
    font-family: 'Montserrat', sans-serif; font-weight: 900;
    font-size: 1.4rem; color: var(--navy);
  }
  .tour-price small { font-size: 0.7rem; font-weight: 500; color: var(--text-light); }
  .tour-price-note { display: block; font-size: 0.8rem; color: var(--text-light); margin-top: 2px; }
  .tour-pickup {
    font-size: 0.82rem; color: #777; line-height: 1.6;
  }
  .tour-pickup strong { color: var(--navy); }

  .section-divider { margin: 60px 0 20px; }

  @media (max-width: 1050px) {
    .boat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .tour-desc-cols, .tour-desc-cols--3 { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .boat-grid { grid-template-columns: 1fr; }
    .tour-cover { min-height: 260px; }
    .tour-cover--short { min-height: 200px; }
    .tour-details { padding: 24px 20px; }
    .tour-pricing { flex-direction: column; text-align: center; align-items: stretch; }
    .tour-pricing--split { grid-template-columns: 1fr; }
  }

  /* ============= GROUP BANNER ============= */
  .group-banner {
    background: var(--navy); padding: 80px 24px; text-align: center;
    position: relative; overflow: hidden;
  }
  .group-glow {
    position: absolute; width: 500px; height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(232,114,92,0.2), transparent 70%);
    top: 50%; left: 50%; transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .group-content { position: relative; z-index: 1; max-width: 600px; margin: 0 auto; }
  .group-content p {
    font-family: 'Montserrat', sans-serif; font-weight: 800;
    font-size: clamp(1.1rem, 3vw, 1.5rem);
    text-transform: uppercase; letter-spacing: 2px;
    color: #fff; margin-bottom: 28px; line-height: 1.5;
  }

  /* ============= GALLERY ============= */
  .gallery {
    background: var(--sand);
    padding: 100px 0 80px;
    position: relative;
    overflow: hidden;
  }
  .gallery-title-row {
    display: flex; align-items: center; justify-content: center; gap: 12px;
  }
  .insta-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .insta-item {
    position: relative;
    display: block;
    aspect-ratio: 9 / 16;
    border-radius: 6px;
    overflow: hidden;
    background: var(--navy-dark);
    box-shadow: 0 18px 44px rgba(26,54,93,0.16);
    isolation: isolate;
    touch-action: manipulation;
    transition: transform 0.45s ease, box-shadow 0.45s ease;
  }
  .insta-item::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 5;
    border: 1px solid rgba(255,255,255,0.28);
    border-radius: inherit;
    pointer-events: none;
  }
  .insta-item img,
  .insta-item video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .insta-item img {
    z-index: 1;
    transition: opacity 0.35s ease, transform 0.7s ease;
  }
  .insta-item video {
    z-index: 2;
    opacity: 0;
    background: var(--navy-dark);
    object-fit: contain;
    transition: opacity 0.3s ease;
  }
  .insta-item__shade {
    position: absolute;
    inset: 0;
    z-index: 3;
    background:
      linear-gradient(180deg, rgba(15,34,64,0.18) 0%, transparent 40%),
      linear-gradient(0deg, rgba(15,34,64,0.42) 0%, transparent 42%);
    opacity: 0.72;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }
  .insta-item__hint,
  .insta-item__instagram {
    position: absolute;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--white);
    border: 1px solid rgba(255,255,255,0.3);
    background: rgba(15,34,64,0.46);
    backdrop-filter: blur(10px);
    pointer-events: none;
  }
  .insta-item__hint {
    left: 12px;
    top: 12px;
    min-height: 34px;
    padding: 0 12px;
    border-radius: 999px;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    box-shadow: 0 10px 28px rgba(15,34,64,0.22);
  }
  .insta-item__hint-mobile { display: none; }
  .insta-item__instagram {
    right: 12px;
    top: 12px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
  }
  .insta-item__actions {
    position: absolute;
    z-index: 4;
    left: 12px;
    right: 12px;
    bottom: 12px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }
  .insta-item__action {
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0 10px;
    border-radius: 999px;
    color: var(--white);
    background: rgba(15,34,64,0.72);
    border: 1px solid rgba(255,255,255,0.32);
    backdrop-filter: blur(12px);
    font-family: 'Montserrat', sans-serif;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.35px;
    line-height: 1;
    white-space: nowrap;
    transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .insta-item__action:hover {
    transform: translateY(-1px);
    background: rgba(232,114,92,0.92);
    border-color: rgba(255,255,255,0.45);
  }
  .insta-item__action:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
  }
  .insta-item.is-playing video { opacity: 1; }
  .insta-item.is-playing img { opacity: 0; }
  .insta-item.is-loading .insta-item__hint {
    background: rgba(232,114,92,0.72);
  }
  .insta-item:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 4px;
  }
  @media (hover: hover) and (pointer: fine) {
    .insta-item:hover {
      transform: translateY(-6px);
      box-shadow: 0 24px 54px rgba(26,54,93,0.22);
    }
    .insta-item:hover img { transform: scale(1.035); }
    .insta-item:hover .insta-item__shade { opacity: 0.38; }
    .insta-item:hover .insta-item__actions,
    .insta-item:focus-within .insta-item__actions {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
  }
  .insta-handle {
    text-align: center; margin-top: 32px;
  }
  .insta-handle a {
    font-family: 'Montserrat', sans-serif; font-weight: 700;
    font-size: 0.9rem; color: var(--navy); letter-spacing: 1.5px;
    text-transform: uppercase; transition: color var(--transition);
  }
  .insta-handle a:hover { color: var(--coral); }

  .gallery-modal {
    border: 0;
    padding: 0;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    background: transparent;
    color: var(--white);
  }
  .gallery-modal::backdrop {
    background: rgba(15,34,64,0.78);
    backdrop-filter: blur(12px);
  }
  .gallery-modal[open] {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 18px;
  }
  .gallery-modal__backdrop {
    position: fixed;
    inset: 0;
    background:
      radial-gradient(circle at 50% 18%, rgba(232,114,92,0.26), transparent 34%),
      rgba(15,34,64,0.68);
    backdrop-filter: blur(12px);
  }
  .gallery-modal__panel {
    position: relative;
    z-index: 1;
    width: min(430px, calc(100vw - 32px));
    max-height: calc(100dvh - 36px);
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 12px;
  }
  .gallery-modal__video {
    width: 100%;
    max-height: min(78dvh, 760px);
    aspect-ratio: 9 / 16;
    object-fit: contain;
    background: #050b14;
    border-radius: 6px;
    box-shadow: 0 24px 80px rgba(0,0,0,0.42);
  }
  .gallery-modal__close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: var(--white);
    background: rgba(15,34,64,0.72);
    border: 1px solid rgba(255,255,255,0.26);
    backdrop-filter: blur(12px);
    transition: transform var(--transition), background var(--transition);
  }
  .gallery-modal__close:hover {
    transform: scale(1.06);
    background: rgba(232,114,92,0.9);
  }
  .gallery-modal__cta {
    min-height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 6px;
    background: var(--coral);
    color: var(--white);
    font-family: 'Montserrat', sans-serif;
    font-size: 0.92rem;
    font-weight: 800;
    letter-spacing: 0.4px;
    box-shadow: 0 16px 36px rgba(232,114,92,0.34);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .gallery-modal__cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 20px 42px rgba(232,114,92,0.42);
  }
  .gallery-modal__close:focus-visible,
  .gallery-modal__cta:focus-visible {
    outline: 3px solid var(--gold);
    outline-offset: 3px;
  }
  body.gallery-modal-open { overflow: hidden; }

  @media (max-width: 768px) {
    .gallery { padding: 84px 0 72px; }
    .insta-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      padding: 0 14px;
    }
    .insta-item {
      border-radius: 5px;
      box-shadow: 0 12px 30px rgba(26,54,93,0.14);
    }
    .insta-item__hint {
      min-height: 30px;
      padding: 0 9px;
      font-size: 0.58rem;
      left: 9px;
      top: 9px;
    }
    .insta-item__hint-desktop { display: none; }
    .insta-item__hint-mobile { display: inline; }
    .insta-item__actions {
      display: none;
    }
    .insta-item__instagram {
      width: 30px;
      height: 30px;
      right: 9px;
      top: 9px;
    }
    .gallery-modal[open] {
      align-items: end;
      padding: 12px;
    }
    .gallery-modal__panel {
      width: min(430px, 100%);
      max-height: calc(100dvh - 24px);
    }
    .gallery-modal__video {
      max-height: calc(100dvh - 94px);
    }
    .gallery-modal__cta {
      min-height: 52px;
      font-size: 0.86rem;
    }
  }

  /* ============= REVIEWS ============= */
  .reviews { background: var(--sand); padding: 100px 0; }
  .reviews-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 20px; max-width: 900px; margin: 0 auto;
  }
  .review-card {
    background: var(--white); border-radius: var(--radius);
    padding: 12px; box-shadow: var(--shadow);
    border-top: 3px solid var(--gold);
  }
  .review-card img { width: 100%; border-radius: 2px; }

  @media (max-width: 600px) {
    .reviews-grid { grid-template-columns: 1fr; }
  }

  /* ============= CONTACTS ============= */
  .contacts { background: var(--sand); padding: 80px 24px; }
  .contacts-buttons {
    display: flex; justify-content: center; gap: 16px; flex-wrap: wrap;
  }
  .contact-btn {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 16px 36px; border-radius: var(--radius);
    font-family: 'Montserrat', sans-serif; font-weight: 800; font-size: 0.85rem;
    color: #fff; text-transform: uppercase; letter-spacing: 1.5px;
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .contact-btn:hover { transform: translateY(-3px); }
  .contact-btn--wa { background: #25D366; box-shadow: 0 8px 24px rgba(37,211,102,0.3); }
  .contact-btn--tg { background: #0088cc; box-shadow: 0 8px 24px rgba(0,136,204,0.3); }
  .contact-btn--ig { background: linear-gradient(135deg, #833AB4, #FD1D1D, #F77737); box-shadow: 0 8px 24px rgba(131,58,180,0.3); }
  .contacts-farewell {
    text-align: center; margin-top: 32px;
    font-family: 'DM Sans', sans-serif; font-size: 1.1rem;
    color: var(--navy); font-weight: 500;
  }
  .contacts-farewell span { font-size: 1.3rem; }

  @media (max-width: 600px) {
    .contacts-buttons { flex-direction: column; align-items: center; }
    .contact-btn { width: 100%; max-width: 300px; justify-content: center; }
  }

  /* ============= FOOTER ============= */
  .footer {
    background: var(--navy-dark); padding: 60px 24px 0;
    position: relative; overflow: hidden;
  }
  .footer-watermark {
    position: absolute; bottom: -20px; left: 50%; transform: translateX(-50%);
    font-family: 'Montserrat', sans-serif; font-weight: 900;
    font-size: 14rem; letter-spacing: 30px;
    color: rgba(255,255,255,0.02); pointer-events: none;
    white-space: nowrap;
  }
  .footer-inner {
    display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 48px;
    max-width: 1100px; margin: 0 auto 48px;
    position: relative; z-index: 1;
  }
  .footer-logo {
    font-family: 'Montserrat', sans-serif; font-weight: 500;
    font-size: 1.1rem; color: #fff; letter-spacing: 0; margin-bottom: 12px;
  }
  .footer-brand p { color: rgba(255,255,255,0.4); line-height: 1.7; font-size: 0.9rem; max-width: 340px; }
  .footer-col h4 {
    font-family: 'Montserrat', sans-serif; font-size: 0.7rem; font-weight: 800;
    letter-spacing: 3px; color: var(--gold); margin-bottom: 20px;
  }
  .footer-col a {
    display: block; color: rgba(255,255,255,0.4);
    font-size: 0.9rem; margin-bottom: 12px;
    transition: color var(--transition);
  }
  .footer-col a:hover { color: #fff; }
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: 24px 0; text-align: center;
    color: rgba(255,255,255,0.2); font-size: 0.82rem;
    position: relative; z-index: 1;
  }

  @media (max-width: 768px) {
    .footer-inner { grid-template-columns: 1fr; gap: 32px; }
    .footer-watermark { font-size: 6rem; letter-spacing: 10px; }
  }

  /* ============= WA FLOAT ============= */
  .wa-float {
    position: fixed; bottom: 28px; right: 28px; z-index: 900;
    width: 56px; height: 56px; border-radius: var(--radius);
    background: #25D366; display: flex; align-items: center; justify-content: center;
    color: #fff; box-shadow: 0 6px 24px rgba(37,211,102,0.4);
    transition: transform var(--transition), box-shadow var(--transition);
    opacity: 0; pointer-events: none;
  }
  .wa-float.visible { opacity: 1; pointer-events: all; }
  .wa-float:hover { transform: scale(1.1); box-shadow: 0 10px 36px rgba(37,211,102,0.5); }

  /* ============= ANIMATIONS ============= */
  .reveal {
    opacity: 0; transform: translateY(24px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }
</style>

<script>
  // Nav scroll + WhatsApp float (combined, passive)
  const nav = document.getElementById('nav');
  const waFloat = document.getElementById('waFloat');
  window.addEventListener('scroll', () => {
    const y = window.scrollY;
    nav?.classList.toggle('scrolled', y > 60);
    waFloat?.classList.toggle('visible', y > 400);
  }, { passive: true });

  // Burger
  const burger = document.getElementById('burger');
  const menu = document.getElementById('mobileMenu');
  burger?.addEventListener('click', () => {
    burger.classList.toggle('active');
    menu?.classList.toggle('open');
    document.body.style.overflow = menu?.classList.contains('open') ? 'hidden' : '';
  });
  menu?.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', () => {
      burger?.classList.remove('active');
      menu?.classList.remove('open');
      document.body.style.overflow = '';
    });
  });

  // Reveal on scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.1 });
  document.querySelectorAll('.about-inner, .tour-block, .section-divider, .group-content, .insta-grid, .reviews-grid, .contacts-buttons').forEach(el => {
    el.classList.add('reveal');
    observer.observe(el);
  });

  // Instagram video gallery: desktop hover previews, mobile tap-to-watch.
  const galleryCards = document.querySelectorAll('[data-gallery-card]');
  const galleryDialog = document.querySelector('[data-gallery-modal]');
  const galleryModalVideo = galleryDialog?.querySelector('[data-gallery-modal-video]');
  const galleryModalLink = galleryDialog?.querySelector('[data-gallery-modal-link]');
  const galleryCanHover = window.matchMedia('(hover: hover) and (pointer: fine)');
  const galleryDefaultInstagramUrl = 'https://www.instagram.com/ann_in_rome/';

  const loadGalleryVideo = (video, src, poster, muted) => {
    if (!video || !src) return;
    if (video.dataset.loadedSrc !== src) {
      video.pause();
      video.src = src;
      video.poster = poster || '';
      video.dataset.loadedSrc = src;
      video.load();
    }
    video.muted = muted;
    video.playsInline = true;
  };

  const resetGalleryModal = () => {
    if (!galleryModalVideo) return;
    galleryModalVideo.pause();
    galleryModalVideo.removeAttribute('src');
    galleryModalVideo.removeAttribute('poster');
    delete galleryModalVideo.dataset.loadedSrc;
    galleryModalVideo.load();
    document.body.classList.remove('gallery-modal-open');
  };

  const closeGalleryModal = () => {
    if (!galleryDialog) return;
    if ('close' in galleryDialog && galleryDialog.open) {
      galleryDialog.close();
      return;
    }
    galleryDialog.removeAttribute('open');
    resetGalleryModal();
  };

  const openGalleryModal = (card) => {
    const src = card.dataset.videoSrc;
    const poster = card.dataset.posterSrc;
    const instagramUrl = card.dataset.instagramUrl || galleryDefaultInstagramUrl;

    if (!galleryDialog || !galleryModalVideo || !src) {
      window.open(instagramUrl, '_blank', 'noopener');
      return;
    }

    if (galleryModalLink) galleryModalLink.href = instagramUrl;
    loadGalleryVideo(galleryModalVideo, src, poster, false);
    document.body.classList.add('gallery-modal-open');

    if ('showModal' in galleryDialog) {
      if (!galleryDialog.open) galleryDialog.showModal();
    } else {
      galleryDialog.setAttribute('open', '');
    }

    const playPromise = galleryModalVideo.play();
    if (playPromise) playPromise.catch(() => {});
  };

  galleryCards.forEach((card) => {
    const video = card.querySelector('video');
    const expandButton = card.querySelector('[data-gallery-expand]');
    const src = card.dataset.videoSrc;
    const poster = card.dataset.posterSrc;
    const openInstagram = () => {
      const instagramUrl = card.dataset.instagramUrl || galleryDefaultInstagramUrl;
      window.open(instagramUrl, '_blank', 'noopener');
    };

    card.addEventListener('pointerenter', () => {
      if (!galleryCanHover.matches || !video || !src) return;
      card.classList.add('is-loading');
      loadGalleryVideo(video, src, poster, true);
      video.currentTime = 0;
      const playPromise = video.play();
      if (!playPromise) {
        card.classList.add('is-playing');
        card.classList.remove('is-loading');
        return;
      }
      playPromise
        .then(() => {
          card.classList.add('is-playing');
          card.classList.remove('is-loading');
        })
        .catch(() => {
          card.classList.remove('is-loading', 'is-playing');
        });
    });

    card.addEventListener('pointerleave', () => {
      if (!galleryCanHover.matches || !video) return;
      video.pause();
      card.classList.remove('is-loading', 'is-playing');
    });

    card.addEventListener('click', (event) => {
      if (event.target.closest('[data-gallery-action]')) return;
      if (galleryCanHover.matches) {
        openInstagram();
        return;
      }
      event.preventDefault();
      openGalleryModal(card);
    });

    card.addEventListener('keydown', (event) => {
      if (event.target.closest('[data-gallery-action]')) return;
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      if (galleryCanHover.matches) {
        openInstagram();
        return;
      }
      openGalleryModal(card);
    });

    expandButton?.addEventListener('click', (event) => {
      event.preventDefault();
      event.stopPropagation();
      openGalleryModal(card);
    });
  });

  galleryDialog?.querySelectorAll('[data-gallery-close]').forEach((control) => {
    control.addEventListener('click', closeGalleryModal);
  });
  galleryDialog?.addEventListener('close', resetGalleryModal);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && galleryDialog?.open) closeGalleryModal();
  });
</script>

</body>
</html>
